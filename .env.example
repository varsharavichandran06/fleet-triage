# Copy to .env and fill in. Every value here is a placeholder; never commit a real key.

# Language model: synthesis, and the decision fallback when no OpenRouter key is set
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Decision model: TypeSafe Jev through OpenRouter. Leave the key empty to use the fallback.
OPENROUTER_API_KEY=
JEV_BASE_URL=https://openrouter.ai/api
JEV_MODEL=jev-1.13
JEV_TIMEOUT_S=5.0
JEV_MAX_RETRIES=2

# Knowledge graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Run state (checkpoints and audit trail)
RUNS_DIR=runs

# Abuse controls
DAILY_RUN_BUDGET=200
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=30
MAX_QUERY_CHARS=4000
API_KEY=
ORIGIN_SECRET=
TRUST_PROXY_HEADER=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Skip live model calls and use deterministic stand-ins (local development only)
DRY_RUN=false

# Logging
LOG_LEVEL=INFO
LOG_PAYLOADS=false
